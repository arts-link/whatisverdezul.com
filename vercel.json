{
  "framework": "hugo",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then hugo --minify; else hugo --minify --baseURL \"https://$VERCEL_URL\"; fi",
  "outputDirectory": "public",
  "installCommand": "git submodule update --init --recursive && npm install",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "whatisverdezul.com" }],
      "destination": "https://www.whatisverdezul.com/$1",
      "permanent": true
    },
    { "source": "/admin", "destination": "/admin/", "permanent": false }
  ]
}
